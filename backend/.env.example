# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string — production uses Neon (managed Postgres):
#   postgresql://user:pass@host-pooler.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=postgres://worldremembers:***@127.0.0.1:5433/world_remembers

# HTTP port the API listens on
PORT=3002

# Comma-separated list of allowed origins, or * for any
CORS_ORIGIN=*
