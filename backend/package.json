{
  "name": "world-remembers-api",
  "version": "1.0.0",
  "description": "The World Remembers persistence API: contributions -> PostgreSQL -> world state",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/backend/src/index.js",
    "dev": "tsx watch src/index.ts",
    "db:migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "test": "node --env-file=.env --import tsx --test tests/api.test.ts tests/stones.test.ts tests/mission.test.ts",
    "test:e2e": "node --env-file=.env --import tsx --test tests/persistence-e2e.test.ts tests/stones-e2e.test.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
