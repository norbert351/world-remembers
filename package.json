{
  "name": "dcl-project",
  "version": "1.0.0",
  "description": "SDK7 Template scene",
  "scripts": {
    "start": "sdk-commands start",
    "deploy": "sdk-commands deploy",
    "build": "sdk-commands build",
    "test:logic": "esbuild tests/state-logic.ts --bundle --platform=node --format=esm --outfile=/tmp/state-logic.mjs && node /tmp/state-logic.mjs",
    "test:smoke": "esbuild tests/scene-smoke.ts --bundle --platform=node --format=esm --alias:~system/Runtime=tests/runtime-stub.ts --outfile=/tmp/scene-smoke.mjs && node /tmp/scene-smoke.mjs",
    "test": "npm run test:logic && npm run test:smoke",
    "upgrade-sdk": "npm install --save-dev @dcl/sdk@latest",
    "upgrade-sdk:next": "npm install --save-dev @dcl/sdk@next"
  },
  "devDependencies": {
    "@dcl/js-runtime": "7.26.0",
    "@dcl/sdk": "latest"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=6.0.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "none"
  }
}