{
  "name": "dcl-project",
  "version": "1.0.0",
  "description": "SDK7 Template scene",
  "scripts": {
    "start": "sdk-commands start",
    "deploy": "sdk-commands deploy",
    "build": "sdk-commands build",
    "test:logic": "esbuild tests/state-logic.ts --bundle --platform=node --format=esm --outfile=/tmp/state-logic.mjs && node /tmp/state-logic.mjs",
    "test:smoke": "esbuild tests/scene-smoke.ts --bundle --platform=node --format=esm --alias:~system/Runtime=tests/runtime-stub.ts --alias:~system/RestrictedActions=tests/restricted-actions-stub.ts --outfile=/tmp/scene-smoke.mjs && node /tmp/scene-smoke.mjs",
    "test:http": "esbuild tests/http-provider.test.ts --bundle --platform=node --format=esm --alias:~system/Runtime=tests/runtime-stub.ts --outfile=/tmp/http-provider.mjs && node --test /tmp/http-provider.mjs",
    "test:stones": "esbuild tests/stone-provider.test.ts --bundle --platform=node --format=esm --alias:~system/Runtime=tests/runtime-stub.ts --outfile=/tmp/stone-provider.mjs && node --test /tmp/stone-provider.mjs",
    "test:ritual": "esbuild tests/ritual.test.ts --bundle --platform=node --format=esm --alias:~system/Runtime=tests/runtime-stub.ts --outfile=/tmp/ritual.mjs && node --test /tmp/ritual.mjs",
    "test:onboarding": "esbuild tests/onboarding.test.ts --bundle --platform=node --format=esm --alias:~system/Runtime=tests/runtime-stub.ts --outfile=/tmp/onboarding.mjs && node --test /tmp/onboarding.mjs",
    "test:interaction": "esbuild tests/interaction.test.ts --bundle --platform=node --format=esm --alias:~system/Runtime=tests/runtime-stub.ts --outfile=/tmp/interaction.mjs && node --test /tmp/interaction.mjs",
    "test:mission": "esbuild tests/mission.test.ts --bundle --platform=node --format=esm --alias:~system/Runtime=tests/runtime-stub.ts --outfile=/tmp/mission.mjs && node --test /tmp/mission.mjs",
    "test:trail": "esbuild tests/trail.test.ts --bundle --platform=node --format=esm --alias:~system/Runtime=tests/runtime-stub.ts --outfile=/tmp/trail.mjs && node --test /tmp/trail.mjs",
    "test:realms": "esbuild tests/realms.test.ts --bundle --platform=node --format=esm --alias:~system/Runtime=tests/runtime-stub.ts --outfile=/tmp/realms.mjs && node --test /tmp/realms.mjs",
    "test:mobile-link": "node --test tests/mobile-link.test.mjs",
    "test:nav": "esbuild tests/navigation.test.ts --bundle --platform=node --format=esm --alias:~system/Runtime=tests/runtime-stub.ts --alias:~system/RestrictedActions=tests/restricted-actions-stub.ts --outfile=/tmp/nav.mjs && node --test /tmp/nav.mjs",
    "qr:dev": "node scripts/generate-mobile-qr.mjs --env dev --preview \"$WR_PREVIEW_URL\" --out /tmp/worldremembers-dev-qr.png",
    "qr:world": "WR_WORLD_NAME=${WR_WORLD_NAME:-} node scripts/generate-mobile-qr.mjs --env world --world \"$WR_WORLD_NAME\"",
    "qr:validate:dev": "node scripts/validate-mobile-qr.mjs --env dev --qr /tmp/worldremembers-dev-qr.png --allowed-dev-host \"$WR_PREVIEW_URL\"",
    "security:scan": "bash scripts/security-scan.sh",
    "test:expedition": "esbuild tests/expedition.test.ts --bundle --platform=node --format=esm --alias:~system/Runtime=tests/runtime-stub.ts --outfile=/tmp/expedition.mjs && node --test /tmp/expedition.mjs",
    "test:living-world": "esbuild tests/living-world.test.ts --bundle --platform=node --format=esm --alias:~system/Runtime=tests/runtime-stub.ts --outfile=/tmp/living-world.mjs && node --test /tmp/living-world.mjs",
    "test:fragments-smoke": "esbuild tests/fragments-smoke.ts --bundle --platform=node --format=esm --alias:~system/Runtime=tests/runtime-stub.ts --outfile=/tmp/fragments-smoke.mjs && node /tmp/fragments-smoke.mjs",
    "test:clarity": "esbuild tests/mission-clarity.test.ts --bundle --platform=node --format=esm --outfile=/tmp/mission-clarity.mjs && node --test /tmp/mission-clarity.mjs",
    "test:presence": "esbuild tests/presence-core.test.ts --bundle --platform=node --format=esm --alias:~system/Runtime=tests/runtime-stub.ts --outfile=/tmp/presence.mjs && node --test /tmp/presence.mjs",
    "test": "npm run test:logic && npm run test:smoke && npm run test:http && npm run test:stones && npm run test:ritual && npm run test:onboarding && npm run test:interaction && npm run test:mission && npm run test:trail && npm run test:realms && npm run test:expedition && npm run test:living-world && npm run test:fragments-smoke && npm run test:mobile-link && npm run test:nav && npm run test:clarity && npm run test:presence",
    "upgrade-sdk": "npm install --save-dev @dcl/sdk@latest",
    "upgrade-sdk:next": "npm install --save-dev @dcl/sdk@next"
  },
  "devDependencies": {
    "@dcl/js-runtime": "7.26.0",
    "@dcl/sdk": "latest"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=6.0.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "none"
  }
}